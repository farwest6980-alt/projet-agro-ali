<%- include('partials/header') %>
<section class="hero">
  <h1>Trouvez vos fournisseurs agroalimentaires,<br>échangez en direct.</h1>
  <p>Annuaire de producteurs, transformateurs et grossistes. Publiez vos offres ou vos besoins, et discutez directement avec vos partenaires.</p>
  <form class="hero-search" action="/fournisseurs">
    <input type="search" name="q" placeholder="Ex : huile d'olive, fromage AOP, emballage carton…">
    <button class="btn">Rechercher</button>
  </form>
  <div class="hero-cta">
    <% if (!user) { %>
      <a class="btn btn-outline" href="/inscription?role=fournisseur">Je suis fournisseur</a>
      <a class="btn btn-outline" href="/inscription?role=acheteur">Je suis acheteur</a>
    <% } else { %>
      <a class="btn btn-outline" href="/annonces/nouvelle">Publier une annonce</a>
    <% } %>
  </div>
  <div class="stats">
    <div><strong><%= stats.suppliers %></strong><span>fournisseurs</span></div>
    <div><strong><%= stats.buyers %></strong><span>acheteurs</span></div>
    <div><strong><%= stats.listings %></strong><span>annonces actives</span></div>
  </div>
</section>

<section>
  <h2 class="section-title">Catégories</h2>
  <div class="chips">
    <% CATEGORIES.forEach(c => { %><a class="chip" href="/fournisseurs?categorie=<%= encodeURIComponent(c) %>"><%= c %></a><% }) %>
  </div>
</section>

<section>
  <div class="section-head"><h2 class="section-title">Dernières annonces</h2><a href="/annonces">Tout voir →</a></div>
  <div class="grid">
    <% listings.forEach(l => { %><%- include('partials/listing-card', { l }) %><% }) %>
    <% if (!listings.length) { %><p class="muted">Aucune annonce pour l'instant.</p><% } %>
  </div>
</section>

<section>
  <div class="section-head"><h2 class="section-title">Nouveaux fournisseurs</h2><a href="/fournisseurs">Voir l'annuaire →</a></div>
  <div class="grid">
    <% suppliers.forEach(s => { %><%- include('partials/supplier-card', { s }) %><% }) %>
  </div>
</section>
<%- include('partials/footer') %>
