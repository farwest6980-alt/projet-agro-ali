<%- include('partials/header', { title: listing.title }) %>
<p><a href="/annonces">← Toutes les annonces</a></p>
<div class="profile-layout">
  <section class="card">
    <div class="card-top">
      <span class="tag tag-<%= listing.type %>"><%= listing.type === 'offre' ? 'Offre — vente' : 'Demande — achat' %></span>
      <span class="muted small">Publiée le <%= formatDate(listing.created_at) %></span>
    </div>
    <% if (!listing.active) { %><div class="flash flash-info">Cette annonce est clôturée.</div><% } %>
    <h1><%= listing.title %></h1>
    <div class="card-meta big">
      <span>🏷️ <%= listing.category %></span>
      <% if (listing.quantity) { %><span>📦 <%= listing.quantity %></span><% } %>
      <% if (listing.price) { %><span>💶 <%= listing.price %></span><% } %>
      <% if (listing.region) { %><span>📍 <%= listing.region %></span><% } %>
    </div>
    <p class="prewrap"><%= listing.description %></p>
  </section>
  <aside class="card profile-card">
    <div class="avatar avatar-lg"><%= listing.company.slice(0, 1).toUpperCase() %></div>
    <h3><a href="/fournisseurs/<%= listing.owner_id %>"><%= listing.company %></a></h3>
    <div class="muted small"><%= listing.role === 'fournisseur' ? 'Fournisseur' : 'Acheteur' %> · <%= [listing.city, listing.user_region].filter(Boolean).join(', ') %></div>
    <% if (!user) { %>
      <a class="btn btn-block" href="/connexion?next=/annonces/<%= listing.id %>">Se connecter pour répondre</a>
    <% } else if (user.id !== listing.owner_id) { %>
      <form method="post" action="/messages/nouveau">
        <input type="hidden" name="to" value="<%= listing.owner_id %>">
        <input type="hidden" name="listing_id" value="<%= listing.id %>">
        <button class="btn btn-block">💬 Contacter à propos de l'annonce</button>
      </form>
    <% } else if (listing.active) { %>
      <form method="post" action="/annonces/<%= listing.id %>/cloturer" onsubmit="return confirm('Clôturer cette annonce ?')">
        <button class="btn btn-outline btn-block">Clôturer l'annonce</button>
      </form>
    <% } %>
  </aside>
</div>
<%- include('partials/footer') %>
