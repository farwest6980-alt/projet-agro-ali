<%- include('partials/header', { title: 'Annonces' }) %>
<div class="section-head">
  <h1>Annonces</h1>
  <a class="btn" href="/annonces/nouvelle">+ Publier une annonce</a>
</div>
<%- include('partials/filters', { placeholder: 'Produit, entreprise…', showType: true }) %>
<p class="muted"><%= listings.length %> annonce<%= listings.length > 1 ? 's' : '' %></p>
<div class="grid">
  <% listings.forEach(l => { %><%- include('partials/listing-card', { l }) %><% }) %>
</div>
<% if (!listings.length) { %><div class="empty">Aucune annonce ne correspond à votre recherche.</div><% } %>
<%- include('partials/footer') %>
