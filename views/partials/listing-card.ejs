<a class="card listing-card" href="/annonces/<%= l.id %>">
  <div class="card-photo">
    <% if (l.photo) { %><img src="/media/listings/<%= l.photo %>_thumb.webp" alt="" loading="lazy">
    <% } else { %><div class="photo-placeholder"><%- icon('image') %></div><% } %>
    <span class="tag tag-<%= l.type %> tag-float"><%= l.type === 'offre' ? 'Offre' : 'Demande' %></span>
  </div>
  <div class="card-body">
    <div class="muted small"><%= l.category %></div>
    <h3><%= l.title %></h3>
    <div class="card-meta">
      <% if (l.quantity) { %><span><%- icon('box') %><%= l.quantity %></span><% } %>
      <% if (l.price) { %><span><%- icon('euro') %><%= l.price %></span><% } %>
      <% if (l.incoterm) { %><span><%- icon('truck') %><%= l.incoterm %></span><% } %>
      <% if (l.country) { %><span><%- icon('pin') %><%= l.country %></span><% } %>
    </div>
    <div class="card-owner small"><%= l.company %> <%- verifiedBadge(l, false) %></div>
  </div>
</a>
