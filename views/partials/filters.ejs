<form class="filters" method="get">
  <input type="search" name="q" placeholder="<%= placeholder %>" value="<%= filters.q %>">
  <% if (typeof showType !== 'undefined' && showType) { %>
  <select name="type">
    <option value="">Offres &amp; demandes</option>
    <option value="offre" <%= filters.type === 'offre' ? 'selected' : '' %>>Offres (vente)</option>
    <option value="demande" <%= filters.type === 'demande' ? 'selected' : '' %>>Demandes (achat)</option>
  </select>
  <% } %>
  <select name="categorie">
    <option value="">Toutes catégories</option>
    <% CATEGORIES.forEach(c => { %><option <%= filters.categorie === c ? 'selected' : '' %>><%= c %></option><% }) %>
  </select>
  <select name="pays">
    <option value="">Tous pays</option>
    <% COUNTRIES.forEach(c => { %><option <%= filters.pays === c ? 'selected' : '' %>><%= c %></option><% }) %>
  </select>
  <label class="check"><input type="checkbox" name="verifie" value="1" <%= filters.verifie ? 'checked' : '' %>> Vérifiés uniquement</label>
  <button class="btn"><%- icon('search') %>Filtrer</button>
</form>
