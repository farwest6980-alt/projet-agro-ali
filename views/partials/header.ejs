<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' · ' : '' %>AgroLink — Agroalimentaire Maghreb · Europe</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body<% if (user) { %> data-user-id="<%= user.id %>"<% } %>>
<header class="topbar">
  <div class="container nav">
    <a href="/" class="brand"><span class="brand-mark"><%- icon('leaf') %></span>AgroLink</a>
    <nav class="links">
      <a href="/fournisseurs">Fournisseurs</a>
      <a href="/annonces">Annonces</a>
      <% if (user) { %>
        <% if (user.is_admin) { %><a href="/admin">Admin<span class="badge"<% if (!adminQueue) { %> hidden<% } %>><%= adminQueue %></span></a><% } %>
        <a href="/messages">Messages<span class="badge" id="unread-badge"<% if (!unread) { %> hidden<% } %>><%= unread %></span></a>
        <a href="/annonces/nouvelle" class="btn btn-small hide-mobile"><%- icon('plus') %>Annonce</a>
        <a href="/profil" class="nav-avatar" title="Mon profil"><%- avatar(user) %></a>
      <% } else { %>
        <a href="/connexion">Connexion</a>
        <a href="/inscription" class="btn btn-small">Inscription</a>
      <% } %>
    </nav>
  </div>
</header>
<main class="container">
<% if (flash) { %><div class="flash flash-<%= flash.type %>"><%= flash.text %></div><% } %>
