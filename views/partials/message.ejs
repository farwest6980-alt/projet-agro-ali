<% const mine = m.sender_id === viewer.id; %>
<% if (m.type === 'devis') { %>
  <% const pending = m.q_status === 'envoye'; const canAnswer = pending && !mine; %>
  <div class="bubble quote <%= mine ? 'mine' : 'theirs' %>" data-id="<%= m.id %>">
    <div class="quote-head">
      <span class="with-icon"><%- icon('file') %><strong><%= m.q_parent_id ? 'Contre-proposition' : 'Devis' %></strong></span>
      <span class="pill pill-<%= m.q_status %>"><%= QUOTE_STATUS[m.q_status] %></span>
    </div>
    <dl class="quote-grid">
      <dt>Produit</dt><dd><%= m.q_product %></dd>
      <dt>Quantité</dt><dd><%= m.q_quantity %></dd>
      <dt>Prix</dt><dd class="price"><%= m.q_price %></dd>
      <dt>Incoterm</dt><dd><%= m.q_incoterm %></dd>
      <dt>Valable jusqu'au</dt><dd><%= formatDay(m.q_valid_until) %></dd>
    </dl>
    <% if (canAnswer) { %>
      <div class="quote-actions">
        <button class="btn btn-small" data-quote-action="accepter" data-quote-id="<%= m.q_id %>"><%- icon('check') %>Accepter</button>
        <button class="btn btn-small btn-outline" data-quote-negotiate="<%= m.q_id %>">Négocier</button>
        <button class="link-btn" data-quote-action="refuser" data-quote-id="<%= m.q_id %>">Refuser</button>
      </div>
      <form class="quote-form counter-form" data-counter-for="<%= m.q_id %>" hidden>
        <div class="small muted">Votre contre-proposition :</div>
        <input name="product" value="<%= m.q_product %>" required maxlength="150" placeholder="Produit">
        <div class="row">
          <input name="quantity" value="<%= m.q_quantity %>" required maxlength="100" placeholder="Quantité">
          <input name="price" value="<%= m.q_price %>" required maxlength="100" placeholder="Prix">
        </div>
        <div class="row">
          <select name="incoterm"><% INCOTERMS.forEach(i => { %><option <%= i === m.q_incoterm ? 'selected' : '' %>><%= i %></option><% }) %></select>
          <input type="date" name="valid_until" value="<%= m.q_valid_until %>" required>
        </div>
        <button class="btn btn-small">Envoyer la contre-proposition</button>
      </form>
    <% } %>
    <time><%= formatDate(m.created_at) %></time>
  </div>
<% } else { %>
  <div class="bubble <%= mine ? 'mine' : 'theirs' %>" data-id="<%= m.id %>"><div class="prewrap"><%= m.body %></div><time><%= formatDate(m.created_at) %></time></div>
<% } %>
