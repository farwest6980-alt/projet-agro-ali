<a class="card supplier-card" href="/fournisseurs/<%= s.id %>">
  <div class="supplier-head">
    <%- avatar(s, 'lg') %>
    <div>
      <h3><%= s.company %> <%- verifiedBadge(s, false) %></h3>
      <div class="muted small"><%= [s.city, s.country].filter(Boolean).join(', ') || 'Localisation non renseignée' %></div>
    </div>
  </div>
  <% if (s.category) { %><span class="tag"><%= s.category %></span><% } %>
  <p class="muted clamp"><%= s.description || 'Pas encore de description.' %></p>
  <% if (s.certifications) { %><div class="small with-icon"><%- icon('award') %><%= s.certifications %></div><% } %>
</a>
